# Optional host port overrides for the devcontainer stack.
# Copy this file to .devcontainer/.env and change values only when a port is already occupied.

APP_PORT=8080
DEBUG_PORT=5005
DEV_DB_EXPOSE_PORT=5432
DEV_RABBITMQ_EXPOSE_PORT=5672
DEV_RABBITMQ_MANAGEMENT_PORT=15672
DEV_MINIO_EXPOSE_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
